PORT=3000
PRICING_API_KEY=your_openai_api_key
PRICING_MODEL=gpt-4o

# Origine ammessa per le richieste CORS dal frontend. In sviluppo si può
# lasciare * (o omettere del tutto); in produzione va ristretta al dominio reale.
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=photos

# Protezione da abuso su /evaluate (ogni chiamata è a pagamento sul modello).
# RATE_LIMIT_MAX_PER_IP: richieste massime per indirizzo IP ogni 10 minuti.
# DAILY_EVALUATION_LIMIT: tetto massimo di valutazioni al giorno, in totale.
RATE_LIMIT_MAX_PER_IP=5
DAILY_EVALUATION_LIMIT=100
